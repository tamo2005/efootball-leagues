# Frontend backend switch
VITE_BACKEND_ENABLED=true

# Google OAuth (server-side only; never expose the client secret to Vite)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional locally; production defaults to https://your-domain/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# Production backend
DATABASE_URL=mysql://user:password@host:3306/efootball_leagues
DATABASE_SSL=true
DB_POOL_SIZE=5

# Optional server-side Hugging Face name-review assistant
# Create a free Hugging Face user access token with inference permissions.
HF_TOKEN=
HF_MODEL=Qwen/Qwen3-4B-Instruct-2507

# Optional first-admin bootstrap, used only by `pnpm db:bootstrap`
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=League Administrator
BOOTSTRAP_ADMIN_PASSWORD=change-this-before-running

# Vite analytics variables remain optional
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
